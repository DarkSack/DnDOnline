{
  "name": "dndonline",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev:server": "npm run dev -w @dndonline/server",
    "dev:web": "npm run dev -w @dndonline/web",
    "db:up": "docker compose up -d db",
    "migrate": "npm run migrate -w @dndonline/server",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "e2e": "playwright test",
    "build": "npm run build --workspaces --if-present"
  },
  "devDependencies": {
    "@playwright/test": "~1.64.1",
    "typescript": "~6.0.2"
  }
}
